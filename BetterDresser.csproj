<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <Author>CoffeeXIV</Author>
    <Name>BetterDresser</Name>
    <AssemblyName>BetterDresser</AssemblyName>
    <Punchline>Catalog of all gear with model previews, click to try it on via Glamourer.</Punchline>
    <Description>Browse every piece of equipment in the game and apply it to your character with Glamourer.</Description>
    <Tags>glamour;glamourer;gear;catalog;screenshots;dresser;previews;fashion</Tags>
    <IconUrl>https://raw.githubusercontent.com/CoffeeXIV/BetterDresser/main/images/icon.png</IconUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="images\icon.png" Condition="Exists('images\icon.png')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>

  <!-- Patch each item came with: xivapi/ffxiv-datamining-patches, copied as is. -->
  <ItemGroup>
    <EmbeddedResource Include="patches\Item.json" LogicalName="Item.json" />
    <EmbeddedResource Include="patches\patchlist.json" LogicalName="patchlist.json" />
  </ItemGroup>

  <!-- The release zip goes on GitHub as BetterDresser.zip (repo.json links to it): DalamudPackager always names it latest.zip. -->
  <Target Name="RenamePackage" AfterTargets="DefaultDalamudPackagerRelease" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName)\latest.zip" DestinationFiles="$(OutputPath)$(AssemblyName)\$(AssemblyName).zip" />
    <Delete Files="$(OutputPath)$(AssemblyName)\latest.zip" />
  </Target>
</Project>
